# ============================================================
# Frontend Environment Variables (.env.example)
# Note: Variables prefixed with VITE_ are embedded into public JS!
# NEVER put private tokens, secrets, or database URLs here.
# ============================================================

# In local development: use /api (proxied by Vite to http://localhost:5000)
# In production on Vercel: set to your live Render backend URL, e.g.:
# VITE_API_BASE_URL=https://my-portfolio-api.onrender.com/api
VITE_API_BASE_URL=/api
